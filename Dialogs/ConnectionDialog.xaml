<Window x:Class="Clawbrower.Dialogs.ConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        MinWidth="380"
        FontFamily="Microsoft YaHei UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown">
    <Border Background="#EE1A1A2E" CornerRadius="12" Margin="4">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel Margin="20,16">
            <TextBlock x:Name="TitleText" Text="连接设置" FontSize="14" FontWeight="SemiBold"
                       Foreground="#EEEEEE" Margin="0,0,0,12"/>

            <!-- Gateway URL：可编辑下拉，支持从历史连接中选择并自动带出凭据 -->
            <TextBlock Text="Gateway 地址" FontSize="12" Foreground="#99EEEEEE" Margin="0,0,0,6"/>
            <ComboBox x:Name="UrlBox" IsEditable="True" FontSize="13"
                      Background="#33222233" Foreground="#EEEEEE"
                      SelectionChanged="UrlBox_SelectionChanged"
                      ToolTip="输入 ws://ip:port，或点右侧箭头选择历史连接">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Url}" FontFamily="Consolas" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding AuthLabel}" FontSize="10"
                                       Foreground="#88678CB3" VerticalAlignment="Center" Margin="10,0,2,0"/>
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
                <ComboBox.Resources>
                    <Style TargetType="TextBox">
                        <Setter Property="Background" Value="#33222233"/>
                        <Setter Property="Foreground" Value="#EEEEEE"/>
                        <Setter Property="CaretBrush" Value="#FFFFFF"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="FontFamily" Value="Consolas"/>
                    </Style>
                </ComboBox.Resources>
            </ComboBox>

            <!-- Auth type -->
            <TextBlock Text="认证方式" FontSize="12" Foreground="#99EEEEEE" Margin="0,10,0,6"/>
            <ComboBox x:Name="AuthTypeCombo"
                       SelectionChanged="AuthTypeCombo_SelectionChanged">
                <ComboBoxItem Content="Token"/>
                <ComboBoxItem Content="密码"/>
            </ComboBox>

            <!-- Token input -->
            <TextBox x:Name="TokenBox" FontSize="13" Padding="10,8"
                     Background="#33222233" Foreground="#EEEEEE" CaretBrush="#FFFFFF"
                     BorderThickness="0" VerticalContentAlignment="Center"
                     FontFamily="Consolas" Margin="0,10,0,0"
                     ToolTip="Gateway Token">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <!-- Password input -->
            <PasswordBox x:Name="PasswordBox" FontSize="13" Padding="10,8"
                         Background="#33222233" Foreground="#EEEEEE" CaretBrush="#FFFFFF"
                         BorderThickness="0" VerticalContentAlignment="Center"
                         FontFamily="Consolas" Margin="0,10,0,0"
                         ToolTip="网关密码"
                         Visibility="Collapsed">
                <PasswordBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </PasswordBox.Resources>
            </PasswordBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="取消" Width="72" Height="32" Click="CancelButton_Click"
                        FontSize="12" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#33334444" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#44445555"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="连接" Width="72" Height="32" Click="ConfirmButton_Click"
                        FontSize="12" Cursor="Hand" Margin="10,0,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#55678CB3" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#77789DC3"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#44567AA0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
