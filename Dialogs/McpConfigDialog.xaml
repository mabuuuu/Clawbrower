<Window x:Class="Clawbrower.Dialogs.McpConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        MinWidth="400"
        FontFamily="Microsoft YaHei UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown">
    <Border Background="#EE1A1A2E" CornerRadius="12" Margin="4">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel Margin="20,16">
            <TextBlock Text="MCP 远程控制设置" FontSize="14" FontWeight="SemiBold"
                       Foreground="#EEEEEE" Margin="0,0,0,12"/>
            <TextBlock Text="配置后可通过 OpenClaw 远程控制本机" FontSize="11"
                       Foreground="#88EEEEEE" Margin="0,0,0,14" TextWrapping="Wrap"/>

            <!-- Device Name -->
            <TextBlock Text="设备名称（必填）" FontSize="12" Foreground="#99EEEEEE" Margin="0,0,0,6"/>
            <TextBox x:Name="DeviceNameBox" FontSize="13" Padding="10,8"
                     Background="#33222233" Foreground="#EEEEEE" CaretBrush="#FFFFFF"
                     BorderThickness="0" VerticalContentAlignment="Center"
                     ToolTip="用于 OpenClaw 识别此设备">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <!-- Local Port -->
            <TextBlock Text="本地端口" FontSize="12" Foreground="#99EEEEEE" Margin="0,10,0,6"/>
            <TextBox x:Name="LocalPortBox" FontSize="13" Padding="10,8"
                     Background="#33222233" Foreground="#EEEEEE" CaretBrush="#FFFFFF"
                     BorderThickness="0" VerticalContentAlignment="Center"
                     FontFamily="Consolas" Text="9527">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <!-- Remote Port -->
            <TextBlock Text="远程端口" FontSize="12" Foreground="#99EEEEEE" Margin="0,10,0,6"/>
            <TextBox x:Name="RemotePortBox" FontSize="13" Padding="10,8"
                     Background="#33222233" Foreground="#EEEEEE" CaretBrush="#FFFFFF"
                     BorderThickness="0" VerticalContentAlignment="Center"
                     FontFamily="Consolas" Text="9527">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <!-- FRP Server -->
            <TextBlock Text="FRP 服务器地址" FontSize="12" Foreground="#99EEEEEE" Margin="0,10,0,6"/>
            <TextBox x:Name="FrpServerBox" FontSize="13" Padding="10,8"
                     Background="#33222233" Foreground="#EEEEEE" CaretBrush="#FFFFFF"
                     BorderThickness="0" VerticalContentAlignment="Center"
                     FontFamily="Consolas" Text="124.222.90.15">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <!-- FRP Server Port -->
            <TextBlock Text="FRP 服务器端口" FontSize="12" Foreground="#99EEEEEE" Margin="0,10,0,6"/>
            <TextBox x:Name="FrpServerPortBox" FontSize="13" Padding="10,8"
                     Background="#33222233" Foreground="#EEEEEE" CaretBrush="#FFFFFF"
                     BorderThickness="0" VerticalContentAlignment="Center"
                     FontFamily="Consolas" Text="7000">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <!-- FRP Auth Token -->
            <TextBlock Text="FRP 认证令牌" FontSize="12" Foreground="#99EEEEEE" Margin="0,10,0,6"/>
            <PasswordBox x:Name="FrpAuthTokenBox" FontSize="13" Padding="10,8"
                         Background="#33222233" Foreground="#EEEEEE" CaretBrush="#FFFFFF"
                         BorderThickness="0" VerticalContentAlignment="Center"
                         FontFamily="Consolas">
                <PasswordBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </PasswordBox.Resources>
            </PasswordBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="取消" Width="72" Height="32" Click="CancelButton_Click"
                        FontSize="12" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#33334444" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#44445555"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="启动" Width="72" Height="32" Click="ConfirmButton_Click"
                        FontSize="12" Cursor="Hand" Margin="10,0,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#55678CB3" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#77789DC3"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#44567AA0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
