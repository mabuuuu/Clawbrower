<Window x:Class="Clawbrower.Dialogs.SpeechSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        MinWidth="400"
        FontFamily="Microsoft YaHei UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown">
    <Border Background="#EE1A1A2E" CornerRadius="12" Margin="4">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel Margin="20,16">
            <TextBlock Text="语音设置" FontSize="14" FontWeight="SemiBold"
                       Foreground="#EEEEEE" Margin="0,0,0,4"/>
            <TextBlock Text="配置语音输入功能，通过语音将音频传到 OpenClaw" FontSize="11"
                       Foreground="#88EEEEEE" Margin="0,0,0,14" TextWrapping="Wrap"/>

            <!-- 语音模式 -->
            <TextBlock Text="语音模式" FontSize="12" Foreground="#99EEEEEE" Margin="0,0,0,6"/>
            <ComboBox x:Name="ModeCombo" SelectedIndex="0" SelectionChanged="ModeCombo_SelectionChanged">
                <ComboBoxItem Content="按住说话 (PTT)" />
                <ComboBoxItem Content="唤醒词模式（说"二七二七"自动对话）" />
            </ComboBox>

            <!-- 唤醒词配置区 -->
            <StackPanel x:Name="WakeWordPanel" Visibility="Collapsed" Margin="0,12,0,0">
                <TextBlock Text="唤醒词：二七二七（本地 ONNX 检测，模型随程序分发）" FontSize="11"
                           Foreground="#88EEEEEE" TextWrapping="Wrap"/>
                <TextBlock Text="触发阈值" FontSize="12" Foreground="#99EEEEEE" Margin="0,12,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <Slider x:Name="ThresholdSlider" Minimum="0.1" Maximum="0.9" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" Width="200" VerticalAlignment="Center"
                            ValueChanged="ThresholdSlider_ValueChanged"/>
                    <TextBlock x:Name="ThresholdValue" Text="0.50" FontSize="12" Foreground="#88EEEEEE"
                               Margin="12,0,0,0" VerticalAlignment="Center" Width="50"/>
                </StackPanel>
                <TextBlock Text="阈值越低越灵敏（易误报），越高越保守（可能漏报）。建议 0.5。" FontSize="11"
                           Foreground="#88678CB3" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="检测到唤醒词后自动开始录音对话，说完停顿约 2 秒自动结束并发送。" FontSize="11"
                           Foreground="#88678CB3" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- PTT 按键 -->
            <TextBlock Text="PTT 按键（点击下方框，按下你想要的键）" FontSize="12"
                       Foreground="#99EEEEEE" Margin="0,14,0,6"/>
            <TextBox x:Name="PttKeyBox" FontSize="13" Padding="10,8"
                     Background="#33222233" Foreground="#EEEEEE" CaretBrush="#FFFFFF"
                     BorderThickness="0" VerticalContentAlignment="Center"
                     IsReadOnly="True" Focusable="True"
                     GotFocus="PttKeyBox_GotFocus"
                     PreviewKeyDown="PttKeyBox_PreviewKeyDown"
                     ToolTip="点击此框，然后按下你想要设置为 PTT 的按键">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <TextBlock x:Name="HintText" Text="当前按键: F12"
                       FontSize="11" Foreground="#88678CB3" Margin="0,6,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="取消" Width="72" Height="32" Click="CancelButton_Click"
                        FontSize="12" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#33334444" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#44445555"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="确定" Width="72" Height="32" Click="ConfirmButton_Click"
                        FontSize="12" Cursor="Hand" Margin="10,0,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#55678CB3" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#77789DC3"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#44567AA0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
