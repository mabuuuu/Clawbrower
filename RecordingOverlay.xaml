<Window x:Class="Clawbrower.RecordingOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Width="240" Height="72"
        IsHitTestVisible="False"
        FontFamily="Microsoft YaHei UI">

    <Border Background="#EE1A1A2E" CornerRadius="16" Margin="4">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="2" Opacity="0.4"/>
        </Border.Effect>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
            <!-- 脉冲红点 -->
            <Ellipse x:Name="PulseDot" Width="12" Height="12" Margin="0,0,12,0">
                <Ellipse.Fill>
                    <SolidColorBrush x:Name="PulseBrush" Color="#FFEF4444"/>
                </Ellipse.Fill>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="PulseDot"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="1.0" To="0.3" Duration="0:0:0.6"
                                                 AutoReverse="True" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <TextBlock Text="说话中..." FontSize="16" FontWeight="SemiBold"
                       Foreground="#EEEEEE" VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
