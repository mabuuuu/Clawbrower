<Window x:Class="Clawbrower.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        Width="440" Height="520"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#99EEEEEE"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBg" Background="Transparent" CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBg" Property="Background" Value="#22678CB3"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBg" Property="Background" Value="#33678CB3"/>
                                <Setter Property="Foreground" Value="#EEEEEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#33222233"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#33222233"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Border Background="#EE1A1A2E" CornerRadius="12" Margin="4">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0" Text="Clawbrower 设置" FontSize="15" FontWeight="SemiBold"
                       Foreground="#EEEEEE" Margin="20,16,20,0"/>

            <!-- Tabs -->
            <TabControl Grid.Row="1" Margin="20,12,20,0">
                <!-- ════════ 外观 ════════ -->
                <TabItem Header="外观">
                    <StackPanel Margin="0,12,0,0">

                        <TextBlock Text="窗口不透明度" FontSize="12" Foreground="#99EEEEEE" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="0" Maximum="1.0" SmallChange="0.01" LargeChange="0.05"
                                    Value="{Binding WindowOpacity, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="1" Text="{Binding WindowOpacity, StringFormat={}{0:P0}}"
                                       Foreground="#AAA" FontSize="11" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="文字不透明度" FontSize="12" Foreground="#99EEEEEE" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="0" Maximum="1.0" SmallChange="0.01" LargeChange="0.05"
                                    Value="{Binding TextOpacity, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="1" Text="{Binding TextOpacity, StringFormat={}{0:P0}}"
                                       Foreground="#AAA" FontSize="11" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="文字颜色" FontSize="12" Foreground="#99EEEEEE" Margin="0,0,0,6"/>
                        <UniformGrid Columns="8" Rows="2" Margin="0,0,0,8">
                            <Border Background="#FFFFFF" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorButton_Click" Tag="#FFFFFF"/>
                            <Border Background="#DDDDDD" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorButton_Click" Tag="#DDDDDD"/>
                            <Border Background="#AAAAAA" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorButton_Click" Tag="#AAAAAA"/>
                            <Border Background="#888888" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorButton_Click" Tag="#888888"/>
                            <Border Background="#EF4444" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorButton_Click" Tag="#EF4444"/>
                            <Border Background="#F97316" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorButton_Click" Tag="#F97316"/>
                            <Border Background="#EAB308" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorButton_Click" Tag="#EAB308"/>
                            <Border Background="#22C55E" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorButton_Click" Tag="#22C55E"/>
                            <Border Background="#06B6D4" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorButton_Click" Tag="#06B6D4"/>
                            <Border Background="#3B82F6" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorButton_Click" Tag="#3B82F6"/>
                            <Border Background="#8B5CF6" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorButton_Click" Tag="#8B5CF6"/>
                            <Border Background="#EC4899" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorButton_Click" Tag="#EC4899"/>
                            <Border Background="#FFE4C4" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorButton_Click" Tag="#FFE4C4"/>
                            <Border Background="#B0E0E6" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorButton_Click" Tag="#B0E0E6"/>
                            <Border Background="#98FB98" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorButton_Click" Tag="#98FB98"/>
                            <Border Background="#DDA0DD" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorButton_Click" Tag="#DDA0DD"/>
                        </UniformGrid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="6" Background="{Binding PreviewColor}" Width="32" Height="24" BorderBrush="#555" BorderThickness="1"/>
                            <TextBox Grid.Column="1" Text="{Binding TextColor, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" FontFamily="Consolas"/>
                        </Grid>

                        <TextBlock Text="全局快捷键（显示/隐藏窗口）" FontSize="12" Foreground="#99EEEEEE" Margin="0,0,0,6"/>
                        <TextBox x:Name="HotkeyBox" Text="{Binding HotkeyDisplay, Mode=OneWay}" IsReadOnly="True" Cursor="Hand"
                                 PreviewMouseLeftButtonDown="HotkeyBox_MouseLeftButtonDown" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                    </StackPanel>
                </TabItem>

                <!-- ════════ 连接 ════════ -->
                <TabItem Header="连接">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Gateway 地址" FontSize="12" Foreground="#99EEEEEE" Margin="0,0,0,6"/>
                        <TextBox x:Name="UrlBox" FontFamily="Consolas"/>
                        <TextBlock Text="ws://ip:port 格式" FontSize="10" Foreground="#66EEEEEE" Margin="0,4,0,14"/>

                        <TextBlock Text="认证方式" FontSize="12" Foreground="#99EEEEEE" Margin="0,0,0,6"/>
                        <ComboBox x:Name="AuthTypeCombo" SelectionChanged="AuthTypeCombo_SelectionChanged">
                            <ComboBoxItem Content="Token"/>
                            <ComboBoxItem Content="密码"/>
                        </ComboBox>

                        <TextBlock x:Name="TokenLabel" Text="Token" FontSize="12" Foreground="#99EEEEEE" Margin="0,14,0,6"/>
                        <TextBox x:Name="TokenBox" FontFamily="Consolas" Margin="0,0,0,4"/>

                        <TextBlock x:Name="PasswordLabel" Text="密码" FontSize="12" Foreground="#99EEEEEE" Margin="0,14,0,6" Visibility="Collapsed"/>
                        <PasswordBox x:Name="PasswordBox" FontFamily="Consolas" Visibility="Collapsed"/>

                        <TextBlock Text="保存后自动重连" FontSize="10" Foreground="#66EEEEEE" Margin="0,14,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </TabItem>

                <!-- ════════ 语音 ════════ -->
                <TabItem Header="语音">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="语音模式" FontSize="12" Foreground="#99EEEEEE" Margin="0,0,0,6"/>
                        <ComboBox x:Name="ModeCombo" SelectedIndex="0">
                            <ComboBoxItem Content="按住说话 (PTT)"/>
                            <ComboBoxItem Content="唤醒词模式（敬请期待）" IsEnabled="False"/>
                        </ComboBox>

                        <TextBlock Text="PTT 按键（点击下方框，按下你想要的键）" FontSize="12" Foreground="#99EEEEEE" Margin="0,14,0,6"/>
                        <TextBox x:Name="PttKeyBox" IsReadOnly="True" Focusable="True"
                                 GotFocus="PttKeyBox_GotFocus" PreviewKeyDown="PttKeyBox_PreviewKeyDown"
                                 ToolTip="点击此框，然后按下你想要设置为 PTT 的按键"/>
                        <TextBlock x:Name="PttHint" Text="当前按键: F12" FontSize="11" Foreground="#88678CB3" Margin="0,6,0,14"/>

                        <TextBlock Text="语音服务器地址" FontSize="12" Foreground="#99EEEEEE" Margin="0,0,0,6"/>
                        <TextBox x:Name="SpeechServerUrl" FontFamily="Consolas" Margin="0,0,0,4"
                                 ToolTip="ws://主机:端口/speech"/>
                        <TextBlock Text="ws://主机:端口/speech 格式，留空则首次连接时弹窗填写" FontSize="10" Foreground="#66EEEEEE" Margin="0,0,0,14"/>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,16">
                <Button Content="取消" Width="72" Height="32" Click="CancelButton_Click" FontSize="12" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#33334444" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#44445555"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="确定" Width="72" Height="32" Click="ConfirmButton_Click" FontSize="12" Cursor="Hand" Margin="10,0,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#55678CB3" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#77789DC3"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#44567AA0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
