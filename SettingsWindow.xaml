<Window x:Class="Clawbrower.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clawbrower 设置"
        Width="360" Height="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        FontFamily="Microsoft YaHei UI"
        Background="#FF1E1E2E"
        Foreground="#EEEEEE">

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Gateway URL -->
        <TextBlock Grid.Row="0" Text="Gateway 地址" FontSize="13" FontWeight="Medium" Margin="0,0,0,6"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding GatewayUrl, UpdateSourceTrigger=PropertyChanged}"
                     Foreground="#EEE" CaretBrush="#EEE"
                     Background="#33222233" BorderThickness="0"
                     Padding="8,5" FontSize="12" FontFamily="Consolas"
                     VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Content="重连"
                    Click="ReconnectButton_Click"
                    Margin="8,0,0,0" Padding="14,5"
                    FontSize="12"
                    Background="#FF678CB3" Foreground="White"
                    BorderThickness="0"/>
        </Grid>

        <!-- Window opacity -->
        <TextBlock Grid.Row="3" Text="窗口不透明度" FontSize="13" FontWeight="Medium" Margin="0,0,0,6"/>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Slider Minimum="0" Maximum="1.0"
                    SmallChange="0.01" LargeChange="0.05"
                    Value="{Binding WindowOpacity, UpdateSourceTrigger=PropertyChanged}"
                    Background="Transparent"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding WindowOpacity, StringFormat={}{0:P0}}"
                       Foreground="#AAA" FontSize="11" Width="40"
                       TextAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- Text opacity -->
        <TextBlock Grid.Row="6" Text="文字不透明度" FontSize="13" FontWeight="Medium" Margin="0,0,0,6"/>
        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Slider Minimum="0" Maximum="1.0"
                    SmallChange="0.01" LargeChange="0.05"
                    Value="{Binding TextOpacity, UpdateSourceTrigger=PropertyChanged}"
                    Background="Transparent"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding TextOpacity, StringFormat={}{0:P0}}"
                       Foreground="#AAA" FontSize="11" Width="40"
                       TextAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- Text color -->
        <TextBlock Grid.Row="9" Text="文字颜色" FontSize="13" FontWeight="Medium" Margin="0,0,0,8"/>
        <Grid Grid.Row="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <UniformGrid Grid.Row="0" Columns="8" Rows="1">
                <Border Background="#FFFFFF" CornerRadius="4" Width="34" Height="22" Cursor="Hand"
                        MouseLeftButtonDown="ColorButton_Click" Tag="#FFFFFF"/>
                <Border Background="#DDDDDD" CornerRadius="4" Width="34" Height="22" Cursor="Hand"
                        MouseLeftButtonDown="ColorButton_Click" Tag="#DDDDDD"/>
                <Border Background="#AAAAAA" CornerRadius="4" Width="34" Height="22" Cursor="Hand"
                        MouseLeftButtonDown="ColorButton_Click" Tag="#AAAAAA"/>
                <Border Background="#888888" CornerRadius="4" Width="34" Height="22" Cursor="Hand"
                        MouseLeftButtonDown="ColorButton_Click" Tag="#888888"/>
                <Border Background="#EF4444" CornerRadius="4" Width="34" Height="22" Cursor="Hand"
                        MouseLeftButtonDown="ColorButton_Click" Tag="#EF4444"/>
                <Border Background="#F97316" CornerRadius="4" Width="34" Height="22" Cursor="Hand"
                        MouseLeftButtonDown="ColorButton_Click" Tag="#F97316"/>
                <Border Background="#EAB308" CornerRadius="4" Width="34" Height="22" Cursor="Hand"
                        MouseLeftButtonDown="ColorButton_Click" Tag="#EAB308"/>
                <Border Background="#22C55E" CornerRadius="4" Width="34" Height="22" Cursor="Hand"
                        MouseLeftButtonDown="ColorButton_Click" Tag="#22C55E"/>
            </UniformGrid>

            <UniformGrid Grid.Row="2" Columns="8" Rows="1">
                <Border Background="#06B6D4" CornerRadius="4" Width="34" Height="22" Cursor="Hand"
                        MouseLeftButtonDown="ColorButton_Click" Tag="#06B6D4"/>
                <Border Background="#3B82F6" CornerRadius="4" Width="34" Height="22" Cursor="Hand"
                        MouseLeftButtonDown="ColorButton_Click" Tag="#3B82F6"/>
                <Border Background="#8B5CF6" CornerRadius="4" Width="34" Height="22" Cursor="Hand"
                        MouseLeftButtonDown="ColorButton_Click" Tag="#8B5CF6"/>
                <Border Background="#EC4899" CornerRadius="4" Width="34" Height="22" Cursor="Hand"
                        MouseLeftButtonDown="ColorButton_Click" Tag="#EC4899"/>
                <Border Background="#FFE4C4" CornerRadius="4" Width="34" Height="22" Cursor="Hand"
                        MouseLeftButtonDown="ColorButton_Click" Tag="#FFE4C4"/>
                <Border Background="#B0E0E6" CornerRadius="4" Width="34" Height="22" Cursor="Hand"
                        MouseLeftButtonDown="ColorButton_Click" Tag="#B0E0E6"/>
                <Border Background="#98FB98" CornerRadius="4" Width="34" Height="22" Cursor="Hand"
                        MouseLeftButtonDown="ColorButton_Click" Tag="#98FB98"/>
                <Border Background="#DDA0DD" CornerRadius="4" Width="34" Height="22" Cursor="Hand"
                        MouseLeftButtonDown="ColorButton_Click" Tag="#DDA0DD"/>
            </UniformGrid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="6"
                        Background="{Binding PreviewColor}"
                        Width="32" Height="24"
                        BorderBrush="#555" BorderThickness="1"/>
                <TextBox Grid.Column="1"
                         Text="{Binding TextColor, UpdateSourceTrigger=PropertyChanged}"
                         Foreground="#EEE" CaretBrush="#EEE"
                         Background="#33222233" BorderThickness="0"
                         Padding="8,4" Margin="8,0,0,0"
                         FontSize="12" FontFamily="Consolas"
                         VerticalContentAlignment="Center"/>
            </Grid>
        </Grid>

        <!-- Hotkey -->
        <TextBlock Grid.Row="12" Text="全局快捷键" FontSize="13" FontWeight="Medium" Margin="0,4,0,6"/>
        <Grid Grid.Row="13">
            <TextBox x:Name="HotkeyBox"
                     Text="{Binding HotkeyDisplay, Mode=OneWay}"
                     Foreground="#EEE" CaretBrush="#EEE"
                     Background="#33222233" BorderThickness="0"
                     Padding="10,6" FontSize="13"
                     VerticalContentAlignment="Center"
                     IsReadOnly="True"
                     Cursor="Hand"
                     PreviewMouseLeftButtonDown="HotkeyBox_MouseLeftButtonDown"
                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
        </Grid>
    </Grid>
</Window>
